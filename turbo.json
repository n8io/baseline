{
	"$schema": "./node_modules/turbo/schema.json",
	"globalPassThroughEnv": ["RENDER_AND_TEST_STOP"],
	"tasks": {
		"//#check": {},
		"//#test": {},
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!CHANGELOG.md", "!README.md"],
			"outputs": ["build/**", "dist/**"]
		},
		"check": {
			"dependsOn": ["build"]
		},
		"test": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "!CHANGELOG.md", "!README.md"]
		},
		"test:unit": {}
	}
}
