{
	"name": "baseline",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.17.0",
	"scripts": {
		"app-create": "node --import ./apps/app/scripts/node-version-require.ts scripts/app-create.ts",
		"check": "biome check . && tsc --noEmit",
		"ci:watch": "node --import ./apps/app/scripts/node-version-require.ts scripts/ci-watch.ts",
		"format": "biome format --write .",
		"knip": "knip",
		"readme-svg": "node scripts/readme-svg-write.ts",
		"release:verify": "node --import ./apps/app/scripts/node-version-require.ts scripts/release-verify.ts",
		"test": "vitest run",
		"test:unit": "turbo run test:unit",
		"version": "changeset version && node scripts/ci-pin-write.ts && biome format --write ."
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.6.7",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.6.6",
		"knip": "^6.46.1",
		"publint": "^0.3.25",
		"tsdown": "0.23.7",
		"turbo": "^2.11.11",
		"typescript": "^7.0.2",
		"vitest": "^5.1.0"
	}
}
