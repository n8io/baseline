{
	"name": "@n8io/baseline-logger",
	"version": "3.1.0",
	"description": "The one pino logger every baseline app and package logs through.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/logger"
	},
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": "./src/index.ts",
		"./err-serialize": "./src/logger-err-serialize.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./err-serialize": {
				"types": "./dist/logger-err-serialize.d.ts",
				"default": "./dist/logger-err-serialize.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run"
	},
	"dependencies": {
		"pino": "^10.4.0"
	}
}
