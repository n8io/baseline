{
	"name": "@n8io/baseline-authn",
	"version": "4.0.0",
	"description": "OIDC code flow, JWT verification and the Actor every baseline app's pages and API use.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/authn"
	},
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./react-router": "./src/react-router.ts",
		"./testing": "./src/testing.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./client": {
				"types": "./dist/client.d.ts",
				"default": "./dist/client.js"
			},
			"./react-router": {
				"types": "./dist/react-router.d.ts",
				"default": "./dist/react-router.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^",
		"jose": "^6.2.15",
		"openid-client": "^6.8.9",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@n8io/baseline-http": "workspace:^",
		"@opentelemetry/api": "^1.10.0",
		"hono": "^4.13.16",
		"react": "^19.3.1",
		"react-router": "^8.5.1"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.10.0",
		"hono": "^4.13.16",
		"react": "^19.3.1",
		"react-router": "^8.5.1"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-router": {
			"optional": true
		}
	}
}
