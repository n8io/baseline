{
	"name": "@n8io/baseline-authn",
	"version": "7.2.0",
	"description": "One Actor on every request: pages sign in through any OIDC provider, the API checks bearer tokens, and Use cases get the same Actor from both.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/authn"
	},
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./react-router": "./src/react-router.ts",
		"./testing": "./src/testing.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./client": {
				"types": "./dist/client.d.ts",
				"default": "./dist/client.js"
			},
			"./react-router": {
				"types": "./dist/react-router.d.ts",
				"default": "./dist/react-router.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run",
		"test:unit": "vitest run"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^",
		"jose": "^6.2.17",
		"openid-client": "^6.9.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@n8io/baseline-http": "workspace:^",
		"@opentelemetry/api": "^1.10.0",
		"hono": "^4.13.19",
		"react": "^19.3.1",
		"react-router": "^8.5.2"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.10.0",
		"hono": "^4.13.19",
		"react-router": "^8.5.2"
	},
	"peerDependenciesMeta": {
		"react-router": {
			"optional": true
		}
	}
}
