{
	"name": "@n8io/baseline-result",
	"version": "0.0.0",
	"description": "Result, ok and err for expected business errors.",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/result"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsdown",
		"check": "biome check . && tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"publint": "^0.3.25",
		"tsdown": "0.23.4"
	}
}
