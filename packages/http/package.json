{
	"name": "@n8io/baseline-http",
	"version": "4.0.1",
	"description": "One shape for every API error: problem bodies with the trace id, OpenAPI error responses checked against the Use cases' errors, and secure defaults.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/http"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run",
		"test:mutation": "stryker run",
		"test:unit": "vitest run"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-shared": "workspace:^"
	},
	"devDependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/context-async-hooks": "3.1.1",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"hono": "^4.13.19",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@opentelemetry/api": "^1.10.0",
		"hono": "^4.13.19",
		"zod": "^4.6.7"
	}
}
