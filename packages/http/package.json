{
	"name": "@n8io/baseline-http",
	"version": "1.1.1",
	"description": "Hono error handling and helpers every baseline app's HTTP intake uses.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/http"
	},
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^"
	},
	"devDependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/context-async-hooks": "3.0.0",
		"hono": "^4.13.16",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@opentelemetry/api": "^1.10.0",
		"hono": "^4.13.16",
		"zod": "^4.6.7"
	}
}
