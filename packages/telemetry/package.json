{
	"name": "@n8io/baseline-telemetry",
	"version": "1.3.0",
	"description": "The OpenTelemetry preload and use-case spans every baseline app starts with.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/telemetry"
	},
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": "./src/index.ts",
		"./register": "./src/register.ts",
		"./span": "./src/telemetry-span.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./register": {
				"types": "./dist/register.d.ts",
				"default": "./dist/register.js"
			},
			"./span": {
				"types": "./dist/telemetry-span.d.ts",
				"default": "./dist/telemetry-span.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-result": "workspace:^",
		"@opentelemetry/exporter-logs-otlp-proto": "0.301.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "0.301.0",
		"@opentelemetry/exporter-trace-otlp-proto": "0.301.0",
		"@opentelemetry/instrumentation-http": "0.301.0",
		"@opentelemetry/instrumentation-pg": "0.78.0",
		"@opentelemetry/instrumentation-pino": "0.71.0",
		"@opentelemetry/instrumentation-redis": "0.73.0",
		"@opentelemetry/instrumentation-runtime-node": "0.38.0",
		"@opentelemetry/instrumentation-undici": "0.35.0",
		"@opentelemetry/sdk-logs": "3.1.0",
		"@opentelemetry/sdk-metrics": "3.1.0",
		"@opentelemetry/sdk-node": "0.301.0",
		"@opentelemetry/sdk-trace": "3.1.0"
	},
	"devDependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/context-async-hooks": "3.1.0",
		"import-in-the-middle": "^3.6.0",
		"protobufjs": "^8.8.1"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.10.0"
	}
}
