{
	"name": "@n8io/baseline-live",
	"version": "4.0.0",
	"description": "SSE live updates over Redis pub/sub every baseline app's pages listen to.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/live"
	},
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./client": {
				"types": "./dist/client.d.ts",
				"default": "./dist/client.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run",
		"test:unit": "vitest run --project unit --passWithNoTests"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^"
	},
	"devDependencies": {
		"@types/react": "^19.3.0",
		"hono": "^4.13.16",
		"react": "^19.3.1",
		"react-router": "^8.5.1",
		"redis": "^6.3.1"
	},
	"peerDependencies": {
		"react": "^19.3.1",
		"react-router": "^8.5.1",
		"redis": "^6.3.1"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-router": {
			"optional": true
		},
		"redis": {
			"optional": true
		}
	}
}
