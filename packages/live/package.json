{
	"name": "@n8io/baseline-live",
	"version": "7.4.0",
	"description": "Live updates: an open page reruns its loaders when something it shows changes, through Server-Sent Events fanned out over Redis pub/sub.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/live"
	},
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./testing": "./src/testing.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./client": {
				"types": "./dist/client.d.ts",
				"default": "./dist/client.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run",
		"test:mutation": "stryker run",
		"test:unit": "vitest run --project unit"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-shared": "workspace:^"
	},
	"devDependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/react": "^19.3.0",
		"hono": "^4.13.19",
		"react": "^19.3.1",
		"react-router": "^8.5.2",
		"redis": "^6.3.1"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.10.0",
		"react": "^19.3.1",
		"react-router": "^8.5.2"
	},
	"peerDependenciesMeta": {
		"react": {
			"optional": true
		},
		"react-router": {
			"optional": true
		}
	}
}
