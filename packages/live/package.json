{
	"name": "@n8io/baseline-live",
	"version": "0.0.0",
	"description": "SSE live updates over Redis pub/sub every baseline app's pages listen to.",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/live"
	},
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./client": {
				"types": "./dist/client.d.ts",
				"default": "./dist/client.js"
			}
		},
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"hono": "^4.13.16",
		"publint": "^0.3.25",
		"react": "^19.3.1",
		"react-router": "^8.5.1",
		"redis": "^6.3.1",
		"tsdown": "0.23.4"
	},
	"peerDependencies": {
		"hono": "^4.13.16",
		"react": "^19.3.1",
		"react-router": "^8.5.1",
		"redis": "^6.3.1"
	},
	"peerDependenciesMeta": {
		"redis": {
			"optional": true
		}
	}
}
