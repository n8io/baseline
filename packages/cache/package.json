{
	"name": "@n8io/baseline-cache",
	"version": "6.4.2",
	"description": "A typed cache that, by default, never takes the Project down: an entry in an older shape or a failing store reads as a miss. Runs on Redis or in memory.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/cache"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run",
		"test:mutation": "stryker run",
		"test:unit": "vitest run --project unit"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-shared": "workspace:^",
		"@standard-schema/spec": "^1.1.0"
	},
	"devDependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/sdk-metrics": "3.1.1",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"redis": "^6.3.1",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.10.0"
	}
}
