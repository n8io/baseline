{
	"name": "@n8io/baseline-id",
	"version": "0.0.0",
	"description": "Prefixed TypeIDs: create, validate and convert to and from UUIDs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/id"
	},
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && publint && pnpm pack --out dist/package.tgz && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@types/node": "^26.6.6",
		"publint": "^0.3.25",
		"tsdown": "0.23.4",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5",
		"zod": "^4.6.7"
	},
	"tsdown": {
		"fixedExtension": false
	}
}
