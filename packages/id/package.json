{
	"name": "@n8io/baseline-id",
	"version": "1.0.0",
	"description": "Prefixed TypeIDs: create, validate and convert to and from UUIDs",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/id"
	},
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run"
	},
	"peerDependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"zod": "^4.6.7"
	}
}
