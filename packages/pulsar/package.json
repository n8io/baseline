{
	"name": "@n8io/baseline-pulsar",
	"version": "3.0.0",
	"description": "Events and Consumers on Apache Pulsar, sent after the transaction commits, with the queue package's inbox for duplicates.",
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/pulsar"
	},
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist",
		"README.md"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run",
		"test:unit": "vitest run --project unit --passWithNoTests"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-queue": "workspace:^",
		"@opentelemetry/core": "3.1.0",
		"pulsar-client": "1.18.0"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.10.0"
	},
	"devDependencies": {
		"@n8io/baseline-postgres": "workspace:^",
		"@n8io/baseline-result": "workspace:^",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/context-async-hooks": "3.1.0",
		"@opentelemetry/sdk-trace": "3.1.0",
		"@types/pg": "^8.23.1",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	}
}
