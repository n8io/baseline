{
	"name": "@n8io/baseline-queue",
	"version": "2.0.0",
	"description": "pg-boss events, consumers and schedules on the app's Postgres, with an inbox for duplicates.",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/queue"
	},
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-result": "workspace:^",
		"@opentelemetry/core": "3.0.0",
		"pg-boss": "^12.38.0"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@types/pg": "^8",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"peerDependenciesMeta": {
		"@types/pg": {
			"optional": true
		}
	},
	"devDependencies": {
		"@n8io/baseline-postgres": "workspace:^",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/context-async-hooks": "3.0.0",
		"@opentelemetry/sdk-trace": "3.0.0",
		"@types/pg": "^8.23.1",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	}
}
