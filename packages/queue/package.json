{
	"name": "@n8io/baseline-queue",
	"version": "9.1.2",
	"description": "Events, Event handlers and Schedules in the Project's own Postgres: Events commit with the rows that caused them and reach each Event handler in order per Event key.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/queue"
	},
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run",
		"test:mutation": "stryker run",
		"test:unit": "vitest run --project unit"
	},
	"dependencies": {
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-result": "workspace:^",
		"@n8io/baseline-shared": "workspace:^",
		"@opentelemetry/core": "3.1.1",
		"@standard-schema/spec": "^1.1.0",
		"pg-boss": "^12.38.2"
	},
	"devDependencies": {
		"@n8io/baseline-postgres": "workspace:^",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/context-async-hooks": "3.1.1",
		"@opentelemetry/sdk-trace": "3.1.1",
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/pg": "^8.23.1",
		"fast-check": "^4.10.3",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.10.0"
	}
}
