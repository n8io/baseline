{
	"$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/core/schema/stryker-schema.json",
	"mutate": [
		"src/postgres-database.ts",
		"src/postgres-keyset.ts",
		"src/postgres-pool.ts",
		"src/postgres-transaction-run.ts",
		"src/postgres-unique-violation.ts",
		"!src/**/*.test.ts"
	],
	"plugins": ["@stryker-mutator/vitest-runner"],
	"testRunner": "vitest",
	"vitest": { "configFile": "vitest.mutation.config.ts" },
	"inPlace": true,
	"coverageAnalysis": "perTest",
	"reporters": ["clear-text"],
	"clearTextReporter": { "allowColor": false, "logTests": false },
	"thresholds": { "high": 95, "low": 90, "break": 90 }
}
