{
	"name": "@n8io/baseline-postgres",
	"version": "7.0.0",
	"description": "One pool, transactions that follow your Result and migrations that run once however many processes start, plus prefixed-id columns and keyset paging.",
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/postgres"
	},
	"exports": {
		".": "./src/index.ts",
		"./testing": "./src/testing.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"publishConfig": {
		"access": "public",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"./testing": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			}
		},
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz --strict && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run",
		"test:mutation": "stryker run",
		"test:unit": "vitest run --project unit"
	},
	"dependencies": {
		"@n8io/baseline-id": "workspace:^",
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-result": "workspace:^",
		"@n8io/baseline-shared": "workspace:^"
	},
	"devDependencies": {
		"@stryker-mutator/core": "^10.1.1",
		"@stryker-mutator/vitest-runner": "^10.1.1",
		"@types/pg": "^8.23.1",
		"drizzle-orm": "1.0.0-rc.5",
		"pg": "^8.23.1"
	},
	"peerDependencies": {
		"@types/pg": "^8",
		"drizzle-orm": "1.0.0-rc.5",
		"pg": "^8.23.1"
	},
	"peerDependenciesMeta": {
		"@types/pg": {
			"optional": true
		}
	}
}
