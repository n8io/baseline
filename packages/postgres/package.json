{
	"name": "@n8io/baseline-postgres",
	"version": "0.0.0",
	"description": "Postgres pool, Result-aware transactions, migrations and prefixed-id columns on pg and Drizzle.",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/n8io/baseline.git",
		"directory": "packages/postgres"
	},
	"engines": {
		"node": ">=26"
	},
	"files": [
		"dist"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"publishConfig": {
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			}
		},
		"registry": "https://npm.pkg.github.com"
	},
	"scripts": {
		"build": "tsdown",
		"check": "tsc --noEmit && pnpm pack --out dist/package.tgz && publint dist/package.tgz && attw dist/package.tgz --profile esm-only",
		"prepack": "tsdown",
		"test": "vitest run"
	},
	"dependencies": {
		"@n8io/baseline-id": "workspace:^",
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-result": "workspace:^"
	},
	"peerDependencies": {
		"drizzle-orm": "1.0.0-rc.5",
		"pg": "^8.23.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"drizzle-orm": "1.0.0-rc.5",
		"pg": "^8.23.1",
		"publint": "^0.3.25",
		"tsdown": "0.23.4",
		"zod": "^4.6.7"
	}
}
