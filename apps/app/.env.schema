# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=true
# @generateTsTypes(path=src/env.d.ts)
# @redact={stdout=true}
# @preventLeaks=true
# @plugin(@varlock/infisical-plugin)
# @initInfisical(projectId=$INFISICAL_PROJECT_ID, environment=prod, siteUrl=$INFISICAL_SITE_URL, clientId=$INFISICAL_CLIENT_ID, clientSecret=$INFISICAL_CLIENT_SECRET)
# ---
# @type=enum(development, test, production) @sensitive=false
APP_ENV=development
# @type=port @sensitive=false
PORT=3000
# @type=port @sensitive=false
HEALTH_PORT=9000
# Milliseconds the Server keeps serving after SIGTERM while it answers /readyz 503, so a load balancer
# stops sending it traffic first; without it 5000. 0 in development and test.
# @type=number(min=0, isDivisibleBy=1) @sensitive=false @required=false
SHUTDOWN_DRAIN_DELAY_MS=
# The host ports compose.yaml publishes. Two Projects on one machine need different ones: a Project made
# from this Template gets its own, from its name, in 20000 to 29999.
# @type=port @sensitive=false
POSTGRES_HOST_PORT=5432
# @type=port @sensitive=false
REDIS_HOST_PORT=6379
# @type=port @sensitive=false
SERVER_HOST_PORT=3000
# @type=port @sensitive=false
HEALTH_HOST_PORT=9000
# The compose project `pnpm dev` and `pnpm dev:reset` run: the Project's name, or in a linked git worktree
# its own instance's, from .env.development.local (scripts/dev-instance.ts).
# @sensitive=false
COMPOSE_PROJECT_NAME=app
# Prefix for the image names in compose.yaml, e.g. mirror.gcr.io/library/ when Docker Hub rate-limits
# @sensitive=false @required=false
IMAGE_REGISTRY=
# postgres:// or postgresql://, or memory:// in development and test
# @type=url(allowedProtocols=[postgres, postgresql, memory])
DATABASE_URL=
# the most Postgres connections one process opens; without it 10 in the Server and 5 in the Worker
# @type=number(min=1, isDivisibleBy=1) @sensitive=false @required=false
DATABASE_POOL_MAX=
# Postgres itself, for migrate, where DATABASE_URL goes through a connection pooler
# @type=url(allowedProtocols=[postgres, postgresql]) @required=false
DATABASE_MIGRATE_URL=
# redis:// or rediss://, or memory:// in development and test
# @type=url(allowedProtocols=[redis, rediss, memory])
CACHE_URL=
# https://, or memory:// in development and test
# @type=url(allowedProtocols=[https, memory]) @sensitive=false
AUTHN_ISSUER_URL=
# @sensitive=false
AUTHN_CLIENT_ID=
AUTHN_CLIENT_SECRET=
# @sensitive=false
AUTHN_AUDIENCE=
# 32+ random bytes, base64url
AUTHN_SECRET=
# @type=enum(fatal, error, warn, info, debug, trace, silent) @sensitive=false
LOG_LEVEL=info
# @sensitive=false
OTEL_SERVICE_NAME=app
# @type=url @sensitive=false @required=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# Mixpanel project token; without one, analytics events go to the debug log and are not sent
# @required=false
MIXPANEL_TOKEN=
# Sentry project DSN; without one, errors are only logged, not reported
# @type=url @required=false
SENTRY_DSN=
# LaunchDarkly server SDK key for this environment; without one, every feature flag answers its declared fallback
# @required=false
LAUNCHDARKLY_SDK_KEY=
# LaunchDarkly client-side ID for this environment, sent to the browser; it is public by design. Without one, the browser's feature flags answer their declared fallbacks
# @sensitive=false @required=false
LAUNCHDARKLY_CLIENT_SIDE_ID=
# The Infisical project and machine identity; needed only where a value is an infisical() reference
# @sensitive=false @required=false
INFISICAL_PROJECT_ID=
# A self-hosted Infisical's address; without it Infisical Cloud
# @type=url @sensitive=false @required=false
INFISICAL_SITE_URL=
# @type=infisicalClientId @required=false
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @required=false
INFISICAL_CLIENT_SECRET=
# schedule overrides: a cron string or off
# @sensitive=false @required=false
SCHEDULE_FOO_STALE_ARCHIVE=
# wiring: schedules
