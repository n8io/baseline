# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=true
# @generateTsTypes(path=src/env.d.ts)
# @redact={stdout=true}
# @preventLeaks=true
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=forEnv(development))
# ---
# @type=enum(development, test, production) @sensitive=false
APP_ENV=development
# @type=port @sensitive=false
PORT=3000
# @type=port @sensitive=false
HEALTH_PORT=9000
# postgres:// or postgresql://, or memory:// in development and test
# @type=url(allowedProtocols=[postgres, postgresql, memory])
DATABASE_URL=
# redis:// or rediss://, or memory:// in development and test
# @type=url(allowedProtocols=[redis, rediss, memory])
CACHE_URL=
# https://, or memory:// in development and test
# @type=url(allowedProtocols=[https, memory]) @sensitive=false
AUTHN_ISSUER_URL=
# @sensitive=false
AUTHN_CLIENT_ID=
AUTHN_CLIENT_SECRET=
# @sensitive=false
AUTHN_AUDIENCE=
# 32+ random bytes, base64url
AUTHN_SECRET=
# @type=enum(fatal, error, warn, info, debug, trace, silent) @sensitive=false
LOG_LEVEL=info
# @sensitive=false
OTEL_SERVICE_NAME=app
# @type=url @sensitive=false @required=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# needed only where a value is an op() reference
# @required=forEnv(production)
OP_SERVICE_ACCOUNT_TOKEN=
# schedule overrides: a cron string or off
# @sensitive=false @required=false
SCHEDULE_FOO_STALE_ARCHIVE=
# domain-create: schedules
