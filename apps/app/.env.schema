# @currentEnv=$APP_ENV
# @defaultRequired=true
# @defaultSensitive=true
# @generateTsTypes(path=src/env.d.ts)
# @redact={stdout=true}
# @preventLeaks=true
# @plugin(@varlock/1password-plugin)
# @initOp(token=$OP_SERVICE_ACCOUNT_TOKEN, allowAppAuth=forEnv(development))
# ---
# @type=enum(development, test, production) @sensitive=false
APP_ENV=development
# @type=port @sensitive=false
PORT=3000
# @type=port @sensitive=false
HEALTH_PORT=9000
# The host ports compose.yaml publishes. Two Projects on one machine need different ones: a Project made
# from this Template gets its own, from its name, in 20000 to 29999.
# @type=port @sensitive=false
POSTGRES_HOST_PORT=5432
# @type=port @sensitive=false
REDIS_HOST_PORT=6379
# @type=port @sensitive=false
SERVER_HOST_PORT=3000
# @type=port @sensitive=false
HEALTH_HOST_PORT=9000
# Prefix for the image names in compose.yaml, e.g. mirror.gcr.io/library/ when Docker Hub rate-limits
# @sensitive=false @required=false
IMAGE_REGISTRY=
# postgres:// or postgresql://, or memory:// in development and test
# @type=url(allowedProtocols=[postgres, postgresql, memory])
DATABASE_URL=
# the most Postgres connections one process opens; without it 10 in the Server and 5 in the Worker
# @type=number(min=1, isDivisibleBy=1) @sensitive=false @required=false
DATABASE_POOL_MAX=
# Postgres itself, for migrate, where DATABASE_URL goes through a connection pooler
# @type=url(allowedProtocols=[postgres, postgresql]) @required=false
DATABASE_MIGRATE_URL=
# redis:// or rediss://, or memory:// in development and test
# @type=url(allowedProtocols=[redis, rediss, memory])
CACHE_URL=
# https://, or memory:// in development and test
# @type=url(allowedProtocols=[https, memory]) @sensitive=false
AUTHN_ISSUER_URL=
# @sensitive=false
AUTHN_CLIENT_ID=
AUTHN_CLIENT_SECRET=
# @sensitive=false
AUTHN_AUDIENCE=
# 32+ random bytes, base64url
AUTHN_SECRET=
# @type=enum(fatal, error, warn, info, debug, trace, silent) @sensitive=false
LOG_LEVEL=info
# @sensitive=false
OTEL_SERVICE_NAME=app
# @type=url @sensitive=false @required=false
OTEL_EXPORTER_OTLP_ENDPOINT=
# Mixpanel project token; without one, analytics events go to the debug log and are not sent
# @required=false
MIXPANEL_TOKEN=
# Sentry project DSN; without one, errors are only logged, not reported
# @type=url @required=false
SENTRY_DSN=
# needed only where a value is an op() reference
# @required=false
OP_SERVICE_ACCOUNT_TOKEN=
# schedule overrides: a cron string or off
# @sensitive=false @required=false
SCHEDULE_FOO_STALE_ARCHIVE=
# domain-create: schedules
