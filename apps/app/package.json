{
	"name": "app",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.17.0",
	"imports": {
		"#authn": "./src/authn.ts",
		"#bridges/*": "./src/bridges/*",
		"#domains/*": "./src/domains/*",
		"#env": "./src/env.ts",
		"#ui/*": "./src/ui/*"
	},
	"scripts": {
		"build": "react-router build",
		"check": "varlock codegen && react-router typegen && biome check . && tsc --noEmit",
		"codegen": "drizzle-kit generate",
		"dev": "node --import varlock/auto-load --import @n8io/baseline-telemetry/register --experimental-loader=@opentelemetry/instrumentation/hook.mjs src/migrate.ts && node --import varlock/auto-load --import @n8io/baseline-telemetry/register --experimental-loader=@opentelemetry/instrumentation/hook.mjs src/seed.ts && (HEALTH_PORT=9001 node --import varlock/auto-load --import @n8io/baseline-telemetry/register --experimental-loader=@opentelemetry/instrumentation/hook.mjs src/worker.ts & node --import varlock/auto-load --import @n8io/baseline-telemetry/register --experimental-loader=@opentelemetry/instrumentation/hook.mjs ./node_modules/@react-router/dev/bin.cjs dev)",
		"format": "biome format --write .",
		"migrate": "node --import varlock/auto-load --import @n8io/baseline-telemetry/register --experimental-loader=@opentelemetry/instrumentation/hook.mjs src/migrate.ts",
		"seed": "node --import varlock/auto-load --import @n8io/baseline-telemetry/register --experimental-loader=@opentelemetry/instrumentation/hook.mjs src/seed.ts",
		"test": "vitest run --project unit",
		"test:integration": "react-router build && vitest run --project integration"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@n8io/baseline-authn": "workspace:^",
		"@n8io/baseline-cache": "workspace:^",
		"@n8io/baseline-health": "workspace:^",
		"@n8io/baseline-http": "workspace:^",
		"@n8io/baseline-id": "workspace:^",
		"@n8io/baseline-live": "workspace:^",
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-postgres": "workspace:^",
		"@n8io/baseline-queue": "workspace:^",
		"@n8io/baseline-result": "workspace:^",
		"@n8io/baseline-shutdown": "workspace:^",
		"@n8io/baseline-telemetry": "workspace:^",
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/instrumentation": "0.300.0",
		"@react-router/node": "^8.5.1",
		"@varlock/1password-plugin": "^1.2.0",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"drizzle-orm": "1.0.0-rc.5",
		"hono": "^4.13.16",
		"lucide-react": "^1.66.0",
		"pg": "^8.23.1",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"react-router-hono-server": "4.1.7",
		"redis": "^6.3.1",
		"varlock": "^1.24.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.4",
		"@react-router/dev": "^8.5.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "1.0.0-rc.5",
		"es-module-lexer": "^3.0.4",
		"shadcn": "4.23.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	}
}
