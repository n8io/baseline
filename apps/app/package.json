{
	"name": "app",
	"version": "12.0.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.17.0",
	"imports": {
		"#authn": "./src/authn.ts",
		"#contexts/*": "./src/contexts/*",
		"#env": "./src/env.ts",
		"#ui/*": "./src/ui/*"
	},
	"scripts": {
		"api-check": "node --import ./scripts/node-version-require.ts scripts/api-check.ts",
		"api-smoke": "node --import ./scripts/node-version-require.ts --import ./src/preload.ts scripts/api-smoke.ts",
		"blocked-keys": "node --import ./src/preload.ts src/blocked-keys.ts",
		"build": "NODE_ENV=production react-router build",
		"check": "node --import ./scripts/node-version-require.ts scripts/check.ts",
		"ci": "pnpm check && pnpm test && pnpm test:integration && pnpm piece-check",
		"codegen": "drizzle-kit generate",
		"dev": "node scripts/dev-instance.ts && varlock run -- docker compose up -d --wait && node --import ./src/preload.ts src/migrate.ts && node --import ./src/preload.ts src/seed.ts && (varlock run -- sh -c 'HEALTH_PORT=$((HEALTH_PORT + 1)) exec node --watch --import ./src/preload.ts src/worker.ts' & node --import ./src/preload.ts --conditions=development ./node_modules/@react-router/dev/bin.cjs dev)",
		"dev:reset": "node scripts/dev-instance.ts && varlock run -- docker compose down --volumes",
		"aggregate-create": "node --import ./scripts/node-version-require.ts scripts/aggregate-create.ts",
		"context-create": "node --import ./scripts/node-version-require.ts scripts/context-create.ts",
		"format": "biome check --write .",
		"glossary-check": "node --import ./scripts/node-version-require.ts scripts/glossary-check.ts",
		"migrate": "node --import ./src/preload.ts src/migrate.ts",
		"piece-check": "node --import ./scripts/node-version-require.ts scripts/piece-check.ts",
		"piece-remove": "node --import ./scripts/node-version-require.ts scripts/piece-remove.ts",
		"sdk-generate": "node --import ./scripts/node-version-require.ts scripts/sdk-generate.ts",
		"seed": "node --import ./src/preload.ts src/seed.ts",
		"template-upgrade": "node --import ./scripts/node-version-require.ts scripts/template-upgrade.ts",
		"test": "vitest run --project unit --project unit-contexts",
		"test:integration": "pnpm build && vitest run --project integration"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@n8io/baseline-analytics": "workspace:^",
		"@n8io/baseline-authn": "workspace:^",
		"@n8io/baseline-cache": "workspace:^",
		"@n8io/baseline-error-tracking": "workspace:^",
		"@n8io/baseline-health": "workspace:^",
		"@n8io/baseline-http": "workspace:^",
		"@n8io/baseline-id": "workspace:^",
		"@n8io/baseline-live": "workspace:^",
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-postgres": "workspace:^",
		"@n8io/baseline-queue": "workspace:^",
		"@n8io/baseline-redis": "workspace:^",
		"@n8io/baseline-result": "workspace:^",
		"@n8io/baseline-shutdown": "workspace:^",
		"@n8io/baseline-telemetry": "workspace:^",
		"@opentelemetry/api": "^1.10.0",
		"@react-router/node": "^8.5.1",
		"@varlock/infisical-plugin": "^2.1.3",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"drizzle-orm": "1.0.0-rc.5",
		"hono": "^4.13.18",
		"import-in-the-middle": "^3.6.0",
		"lucide-react": "^1.72.0",
		"pg": "^8.23.1",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"react-router-hono-server": "4.1.9",
		"swagger-ui-dist": "^5.35.0",
		"varlock": "^1.25.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.7",
		"@react-router/dev": "^8.5.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "1.0.0-rc.5",
		"es-module-lexer": "^3.0.4",
		"orval": "8.48.0",
		"protobufjs": "^8.8.1",
		"shadcn": "4.23.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vitest": "^5.1.0"
	}
}
