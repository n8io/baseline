{
	"name": "app",
	"version": "3.0.0",
	"license": "MIT",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"packageManager": "pnpm@12.17.0",
	"imports": {
		"#authn": "./src/authn.ts",
		"#bridges/*": "./src/bridges/*",
		"#domains/*": "./src/domains/*",
		"#env": "./src/env.ts",
		"#ui/*": "./src/ui/*"
	},
	"scripts": {
		"build": "NODE_ENV=production react-router build",
		"check": "varlock codegen && react-router typegen && biome check . && tsc --noEmit",
		"ci": "pnpm check && pnpm test && pnpm test:integration",
		"codegen": "drizzle-kit generate",
		"dev": "docker compose up -d --wait && node --import ./src/preload.ts src/migrate.ts && node --import ./src/preload.ts src/seed.ts && (HEALTH_PORT=9001 node --watch --import ./src/preload.ts src/worker.ts & node --import ./src/preload.ts --conditions=development ./node_modules/@react-router/dev/bin.cjs dev)",
		"domain-create": "node scripts/domain-create.ts",
		"format": "biome format --write .",
		"glossary-check": "node scripts/glossary-check.ts",
		"migrate": "node --import ./src/preload.ts src/migrate.ts",
		"piece-remove": "node scripts/piece-remove.ts",
		"seed": "node --import ./src/preload.ts src/seed.ts",
		"template-upgrade": "node scripts/template-upgrade.ts",
		"test": "vitest run --project unit",
		"test:integration": "pnpm build && vitest run --project integration"
	},
	"dependencies": {
		"@hono/zod-openapi": "^1.6.3",
		"@n8io/baseline-authn": "workspace:^",
		"@n8io/baseline-cache": "workspace:^",
		"@n8io/baseline-health": "workspace:^",
		"@n8io/baseline-http": "workspace:^",
		"@n8io/baseline-id": "workspace:^",
		"@n8io/baseline-live": "workspace:^",
		"@n8io/baseline-logger": "workspace:^",
		"@n8io/baseline-postgres": "workspace:^",
		"@n8io/baseline-queue": "workspace:^",
		"@n8io/baseline-result": "workspace:^",
		"@n8io/baseline-shutdown": "workspace:^",
		"@n8io/baseline-telemetry": "workspace:^",
		"@opentelemetry/api": "^1.10.0",
		"@react-router/node": "^8.5.1",
		"@varlock/1password-plugin": "^2.0.6",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"drizzle-orm": "1.0.0-rc.5",
		"hono": "^4.13.16",
		"import-in-the-middle": "^3.6.0",
		"pg": "^8.23.1",
		"radix-ui": "^1.8.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-router": "^8.5.1",
		"react-router-hono-server": "4.1.7",
		"redis": "^6.3.1",
		"varlock": "^1.24.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.5",
		"@react-router/dev": "^8.5.1",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26.6.6",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"drizzle-kit": "1.0.0-rc.5",
		"es-module-lexer": "^3.0.4",
		"protobufjs": "^8.8.1",
		"shadcn": "4.23.0",
		"tailwindcss": "^4.3.4",
		"typescript": "^7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	}
}
