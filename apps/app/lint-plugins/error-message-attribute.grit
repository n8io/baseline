// An error's message can hold names or other personal data, so it never goes on a span or into a log's fields.
language js

or {
	`$_.setAttribute($_, $value)`,
	`$_.setAttributes($value)`,
	`telemetrySpanAttributesSet($value)`,
	`$logger.$level($value, $...)` where { $logger <: or { `logger`, `log`, `ctx.logger` }, $level <: or { `error`, `warn`, `info`, `debug` } }
} as $call where {
	$value <: contains `$_.message`,
	register_diagnostic(span=$call, message="An error's message never goes on a span attribute or into a log's fields; log the error itself (logger.error({ err }, ...)) so the logger redacts it, or set a count or id", severity="error")
}
