{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": false,
	"overrides": [
		{
			"includes": [
				"src/**",
				"!**/*.test.ts",
				"!**/*.test.tsx",
				"!src/contexts/**/*.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@n8io/baseline-*/testing"],
										"message": "A24: only *.test.ts(x) files and files under test/ import a Package's test helpers; production code imports @n8io/baseline-<package>, where its memory adapter is"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/ui/**",
				"!**/*.test.ts",
				"!**/*.test.tsx",
				"!src/ui/entry.server.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@n8io/baseline-*/testing"],
										"message": "A24: only *.test.ts(x) files and files under test/ import a Package's test helpers; production code imports @n8io/baseline-<package>, where its memory adapter is"
									},
									{
										"group": ["@n8io/baseline-logger"],
										"message": "A9: contexts and the UI never log; return an error or set a span attribute, and log in the entry points (src/ui/entry.server.tsx for page errors)"
									},
									{
										"group": ["#contexts/*/**", "!#contexts/*/index.ts"],
										"message": "A10: the UI calls contexts only through src/contexts/<context>/index.ts; loaders and actions get Use cases from the load context"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["src/contexts/*/index.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@n8io/baseline-*/testing"],
										"message": "A24: only *.test.ts(x) files and files under test/ import a Package's test helpers; production code imports @n8io/baseline-<package>, where its memory adapter is"
									},
									{
										"group": ["@n8io/baseline-logger"],
										"message": "A9: contexts and the UI never log; return an error or set a span attribute, and log in the entry points (src/ui/entry.server.tsx for page errors)"
									},
									{
										"group": ["#ui/**", "**/ui/**"],
										"message": "A10: contexts never import the UI; the UI calls the context"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/contexts/*/*.ts",
				"!src/contexts/*/index.ts",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@n8io/baseline-*/testing"],
										"message": "A24: only *.test.ts(x) files and files under test/ import a Package's test helpers; production code imports @n8io/baseline-<package>, where its memory adapter is"
									},
									{
										"group": ["@n8io/baseline-logger"],
										"message": "A9: contexts and the UI never log; return an error or set a span attribute, and log in the entry points (src/ui/entry.server.tsx for page errors)"
									},
									{
										"group": ["#ui/**", "**/ui/**"],
										"message": "A10: contexts never import the UI; the UI calls the context"
									},
									{
										"group": ["**/*.memory.ts"],
										"message": "A19: only *.test.ts files (and adapters/outbound/) import memory adapters; production code gets ports from <context>PortsCreate in adapters/outbound/index.ts"
									},
									{
										"group": [
											"@n8io/baseline-*",
											"!@n8io/baseline-result",
											"!@n8io/baseline-id"
										],
										"message": "A21: business code imports only @n8io/baseline-result and @n8io/baseline-id, plus @n8io/baseline-telemetry/span in application/ and the types Inbox (queue) and Actor (authn) in domain/ and application/; reach any other shared package through a port implemented in adapters/outbound/"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/contexts/*/domain/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@n8io/baseline-*/testing"],
										"message": "A24: only *.test.ts(x) files and files under test/ import a Package's test helpers; production code imports @n8io/baseline-<package>, where its memory adapter is"
									},
									{
										"group": ["@n8io/baseline-logger"],
										"message": "A9: contexts and the UI never log; return an error or set a span attribute, and log in the entry points (src/ui/entry.server.tsx for page errors)"
									},
									{
										"group": ["#ui/**", "**/ui/**"],
										"message": "A10: contexts never import the UI; the UI calls the context"
									},
									{
										"group": ["**/*.memory.ts"],
										"message": "A19: only *.test.ts files (and adapters/outbound/) import memory adapters; production code gets ports from <context>PortsCreate in adapters/outbound/index.ts"
									},
									{
										"group": ["@hono/*"],
										"message": "A7: domain/ stays free of HTTP; put OpenAPI schemas in adapters/inbound/<model>-routes.ts"
									},
									{
										"group": [
											"**",
											"!./**",
											"!zod",
											"!@n8io/baseline-result",
											"!@n8io/baseline-id",
											"!@n8io/baseline-authn",
											"!../../../id-schema.ts"
										],
										"message": "A2: domain/ is pure: it imports only its own domain/, zod, src/id-schema.ts, the result Package and the types of the authn and id Packages; move this to a Use case in application/"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/contexts/*/application/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@n8io/baseline-*/testing"],
										"message": "A24: only *.test.ts(x) files and files under test/ import a Package's test helpers; production code imports @n8io/baseline-<package>, where its memory adapter is"
									},
									{
										"group": ["@n8io/baseline-logger"],
										"message": "A9: contexts and the UI never log; return an error or set a span attribute, and log in the entry points (src/ui/entry.server.tsx for page errors)"
									},
									{
										"group": ["#ui/**", "**/ui/**"],
										"message": "A10: contexts never import the UI; the UI calls the context"
									},
									{
										"group": ["**/*.memory.ts"],
										"message": "A19: only *.test.ts files (and adapters/outbound/) import memory adapters; production code gets ports from <context>PortsCreate in adapters/outbound/index.ts"
									},
									{
										"group": [
											"@n8io/baseline-*",
											"!@n8io/baseline-result",
											"!@n8io/baseline-id",
											"!@n8io/baseline-telemetry/span",
											"!@n8io/baseline-queue",
											"!@n8io/baseline-authn"
										],
										"message": "A21: business code imports only @n8io/baseline-result and @n8io/baseline-id, plus @n8io/baseline-telemetry/span in application/ and the types Inbox (queue) and Actor (authn) in domain/ and application/; reach any other shared package through a port implemented in adapters/outbound/"
									},
									{
										"group": ["@n8io/baseline-queue"],
										"importNamePattern": "Inbox",
										"invertImportNamePattern": true,
										"message": "A21: business code imports only the Inbox type from @n8io/baseline-queue"
									},
									{
										"group": ["@n8io/baseline-authn"],
										"importNamePattern": "Actor",
										"invertImportNamePattern": true,
										"message": "A21: business code imports only the Actor type from @n8io/baseline-authn"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/contexts/*/adapters/inbound/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@n8io/baseline-*/testing"],
										"message": "A24: only *.test.ts(x) files and files under test/ import a Package's test helpers; production code imports @n8io/baseline-<package>, where its memory adapter is"
									},
									{
										"group": ["@n8io/baseline-logger"],
										"message": "A9: contexts and the UI never log; return an error or set a span attribute, and log in the entry points (src/ui/entry.server.tsx for page errors)"
									},
									{
										"group": ["#ui/**", "**/ui/**"],
										"message": "A10: contexts never import the UI; the UI calls the context"
									},
									{
										"group": ["**/*.memory.ts"],
										"message": "A19: only *.test.ts files (and adapters/outbound/) import memory adapters; production code gets ports from <context>PortsCreate in adapters/outbound/index.ts"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/contexts/*/adapters/outbound/**",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["@n8io/baseline-*/testing"],
										"message": "A24: only *.test.ts(x) files and files under test/ import a Package's test helpers; production code imports @n8io/baseline-<package>, where its memory adapter is"
									},
									{
										"group": ["@n8io/baseline-logger"],
										"message": "A9: contexts and the UI never log; return an error or set a span attribute, and log in the entry points (src/ui/entry.server.tsx for page errors)"
									},
									{
										"group": ["#ui/**", "**/ui/**"],
										"message": "A10: contexts never import the UI; the UI calls the context"
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": [
				"src/contexts/*/application/**",
				"!src/contexts/*/application/ports.ts",
				"!**/*.test.ts",
				"!**/*.test.tsx"
			],
			"plugins": ["./lint-plugins/system-time.grit"]
		},
		{
			"includes": ["src/contexts/*/adapters/outbound/**"],
			"plugins": ["./lint-plugins/sql-raw.grit"]
		},
		{
			"includes": ["src/**", "!**/*.test.ts", "!**/*.test.tsx"],
			"plugins": ["./lint-plugins/process-env.grit"]
		},
		{
			"includes": [
				"**",
				"!clients/sdk/sdk.ts",
				"!**/*.test.ts",
				"!**/*.test.tsx",
				"!**/*-test-*.ts"
			],
			"plugins": ["./lint-plugins/max-params.grit"]
		},
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx", "**/*-test-*.ts"],
			"plugins": ["./lint-plugins/no-mocks.grit"]
		},
		{
			"includes": ["clients/sdk/sdk.ts"],
			"linter": {
				"enabled": false
			}
		},
		{
			"includes": ["**/*.test.ts", "**/*.test.tsx", "**/*-test-*.ts"],
			"linter": {
				"rules": {
					"complexity": {
						"useMaxParams": "off"
					}
				}
			}
		}
	],
	"linter": {
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noAdjacentSpacesInRegex": "error",
				"noArguments": "error",
				"noBannedTypes": "error",
				"noCommaOperator": "error",
				"noEmptyTypeParameters": "error",
				"noExtraBooleanCast": "error",
				"noFlatMapIdentity": "error",
				"noImportantStyles": "error",
				"noStaticOnlyClass": "error",
				"noThisInStatic": "error",
				"noUselessCatch": "error",
				"noUselessConstructor": "error",
				"noUselessContinue": "error",
				"noUselessEmptyExport": "error",
				"noUselessEscapeInRegex": "error",
				"noUselessFragments": "error",
				"noUselessLabel": "error",
				"noUselessLoneBlockStatements": "error",
				"noUselessRename": "error",
				"noUselessStringRaw": "error",
				"noUselessSwitchCase": "error",
				"noUselessTernary": "error",
				"noUselessThisAlias": "error",
				"noUselessTypeConstraint": "error",
				"noUselessUndefinedInitialization": "error",
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 2
					}
				},
				"useArrowFunction": "error",
				"useDateNow": "error",
				"useFlatMap": "error",
				"useIndexOf": "error",
				"useLiteralKeys": "off",
				"useMathMinMax": "error",
				"useNumericLiterals": "error",
				"useOptionalChain": "error",
				"useRegexLiterals": "error",
				"useSimpleNumberKeys": "error"
			},
			"correctness": {
				"noUnusedFunctionParameters": "error",
				"noUnusedImports": "error",
				"noUnusedLabels": "error",
				"noUnusedPrivateClassMembers": "error",
				"noUnusedVariables": "error",
				"useParseIntRadix": "error"
			},
			"nursery": {
				"noFloatingPromises": "error",
				"noMisusedPromises": "error",
				"useAwaitThenable": "error",
				"useExhaustiveSwitchCases": "error"
			},
			"performance": {
				"noAccumulatingSpread": "error",
				"noDynamicNamespaceImportAccess": "error",
				"useDomNodeTextContent": "error"
			},
			"style": {
				"noDescendingSpecificity": "error",
				"noNonNullAssertion": "error",
				"useArrayLiterals": "error",
				"useConst": "error",
				"useDeprecatedReason": "error",
				"useExponentiationOperator": "error",
				"useExportType": "error",
				"useImportType": "error",
				"useLiteralEnumMembers": "error",
				"useNodejsImportProtocol": "error",
				"useShorthandFunctionType": "error",
				"useTemplate": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"chai": "Assert with expect(); Vitest requireAssertions does not count chai assert calls.",
							"vitest": {
								"importNames": ["assert"],
								"message": "Assert with expect(); Vitest requireAssertions does not count chai assert calls."
							}
						}
					}
				}
			},
			"suspicious": {
				"noApproximativeNumericConstant": "error",
				"noCatchAssign": "error",
				"noConfusingLabels": "error",
				"noConfusingVoidType": "error",
				"noConstEnum": "error",
				"noControlCharactersInRegex": "error",
				"noDeprecatedMediaType": "error",
				"noDocumentCookie": "error",
				"noDuplicateEnumValues": "error",
				"noDuplicateFields": "error",
				"noEmptyBlock": "error",
				"noExplicitAny": "error",
				"noExtraNonNullAssertion": "error",
				"noGlobalIsFinite": "error",
				"noGlobalIsNan": "error",
				"noIrregularWhitespace": "error",
				"noOctalEscape": "error",
				"noProto": "error",
				"noPrototypeBuiltins": "error",
				"noQuickfixBiome": "error",
				"noRedundantUseStrict": "error",
				"noSuspiciousSemicolonInJsx": "error",
				"noTemplateCurlyInString": "error",
				"noTsIgnore": "error",
				"noUselessEscapeInString": "error",
				"noUselessRegexBackrefs": "error",
				"useAdjacentOverloadSignatures": "error",
				"useBiomeIgnoreFolder": "error",
				"useDefaultSwitchClauseLast": "error",
				"useGoogleFontDisplay": "error",
				"useIsArray": "error"
			}
		}
	},
	"files": {
		"includes": [
			"**",
			"!build",
			"!migrations/*/snapshot.json",
			"!src/env.d.ts",
			"!.react-router"
		]
	},
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	}
}
