# References only, never a value. Resolved at boot with OP_SERVICE_ACCOUNT_TOKEN.
DATABASE_URL=op(op://app-production/database/url)
CACHE_URL=op(op://app-production/cache/url)
AUTHN_ISSUER_URL=op(op://app-production/authn/issuer-url)
AUTHN_CLIENT_ID=op(op://app-production/authn/client-id)
AUTHN_CLIENT_SECRET=op(op://app-production/authn/client-secret)
AUTHN_AUDIENCE=op(op://app-production/authn/audience)
AUTHN_SECRET=op(op://app-production/authn/secret)
