# Dev values only, nothing from Infisical. For a real provider, put infisical() references and the INFISICAL variables in .env.development.local (they read the prod environment).
DATABASE_URL=postgres://baseline:baseline@localhost:${POSTGRES_HOST_PORT}/baseline
CACHE_URL=redis://localhost:${REDIS_HOST_PORT}
SHUTDOWN_DRAIN_DELAY_MS=0
# The dev Server's ports. A Project gets its own, from its name, so two Projects run pnpm dev at once.
PORT=3000
HEALTH_PORT=9000
AUTHN_ISSUER_URL=memory://
AUTHN_CLIENT_ID=dev
AUTHN_CLIENT_SECRET=memory-issuer-ignores-this
AUTHN_AUDIENCE=dev
AUTHN_SECRET=jUu2hFjuWWolGyWs2mQxArUaISmTrSlPtXwF7PtYmzc
